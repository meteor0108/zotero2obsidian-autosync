{
	"manifest_version": 2,
	"name": "Zotero2Obsidian Autosync",
	"version": "2.0.0",
	"description": "Keeps an Obsidian paper note for every Zotero paper, with its Pass 2 note synced in.",
	"author": "meteor0108",
	"homepage_url": "https://github.com/meteor0108/zotero2obsidian-autosync",
	"icons": {
		"48": "icons/icon.svg",
		"96": "icons/icon.svg"
	},
	"applications": {
		"zotero": {
			"id": "zotero2obsidian@meteor0108.github.io",
			"update_url": "https://raw.githubusercontent.com/meteor0108/zotero2obsidian-autosync/main/updates.json",
			"strict_min_version": "7.0",
			"strict_max_version": "9.*"
		}
	}
}
